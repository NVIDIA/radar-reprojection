load("@rules_cc//cc:defs.bzl", "cc_library")

COMMON_COPTS = ["-Wall", "-Wextra", "-Wno-error=maybe-uninitialized", "-std=c++20"]

cc_library(
    name = "algorithm_compat",
    hdrs = ["BasicTypes.hpp", "Logger.hpp"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "algorithm",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.hpp"]),
    copts = COMMON_COPTS,
    deps = [
        ":algorithm_compat",
        "@eigen",
        "@nlohmann_json//:json",
    ],
    visibility = ["//visibility:public"],
)
