module(
    name = "radar_reprojection",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc",      version = "0.0.17")
bazel_dep(name = "platforms",     version = "0.0.10")
bazel_dep(name = "nlohmann_json", version = "3.11.3")
bazel_dep(name = "googletest",    version = "1.15.2", dev_dependency = True)
bazel_dep(name = "grpc",         version = "1.66.0.bcr.3", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "protobuf",     version = "29.0")
bazel_dep(name = "rules_proto",  version = "7.0.2")
bazel_dep(name = "rules_python", version = "0.36.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.10",
    is_default     = True,
)
use_repo(python, "python_3_10")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name          = "pip",
    python_version    = "3.10",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")

# Eigen via new_local_repository against $CONDA_PREFIX. The BCR `eigen` module
# pins a sha256 against gitlab.com's auto-generated archive endpoint, which
# regenerates checksums non-deterministically; bzlmod's http_archive can't
# follow gitlab's release-asset redirects either.
eigen_local = use_repo_rule("//third_party/eigen:eigen.bzl", "eigen_local")
eigen_local(name = "eigen")
